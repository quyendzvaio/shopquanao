# ─────────────────────────────────────────────
# Fashion Shop — Environment Template
# Copy to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────
LLM_PROVIDER=deepseek
LLM_API_KEY=your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=25

# For an OpenAI-compatible gateway, use:
# LLM_PROVIDER=openai_compatible

# HTTP gateway
# Production default is 80. Use 8090 locally only if port 80 is already busy.
NGINX_HTTP_PORT=80

# MCP tool transport. Use shadow during rollout, mcp after validation, or
# internal for an emergency rollback to the legacy in-process ToolRegistry.
CHATBOT_TOOL_TRANSPORT=mcp
MCP_SERVICE_TOKEN=replace-with-a-long-random-secret
MCP_REQUEST_TIMEOUT_MS=80000
MCP_REQUEST_TIMEOUT=85
MCP_STDIO_NODE=/usr/bin/node
MCP_STDIO_SCRIPT=/opt/mcp-server/dist/stdio.js

# Canonical styling mode: official FindMine synthetic demo response followed by
# strict LLM attribute extraction and real shop Product Search grounding.
FASHION_PROVIDER=findmine_demo
FINDMINE_ENABLED=true
FINDMINE_DEMO_ENABLED=true
FINDMINE_DEMO_MODE=true
FINDMINE_LIVE_VERIFIED=false
FINDMINE_API_URL=https://api.findmine.com
FINDMINE_APP_ID=DEMO_APP_ID
FINDMINE_API_VERSION=v3
FINDMINE_DEFAULT_REGION=us
FINDMINE_DEFAULT_LANGUAGE=en
FINDMINE_MCP_NODE=/usr/bin/node
FINDMINE_MCP_SCRIPT=/opt/findmine-mcp/build/index.js
FINDMINE_STARTUP_TIMEOUT_MS=5000
FINDMINE_REQUEST_TIMEOUT_MS=15000
FINDMINE_RETRY_ATTEMPTS=1
FINDMINE_PRODUCT_IDENTIFIER_KEY=product_id
FINDMINE_COLOR_IDENTIFIER_KEY=product_color_id
FASHION_EVENT_STREAM=fashion:events
FASHION_EVENT_GROUP=proactive-styling

# RAG / VectorDB
QDRANT_URL=http://qdrant:6333
RAG_ML_URL=http://rag-ml:8000
KNOWLEDGE_COLLECTION=shop_knowledge_v2
EMBEDDING_PROVIDER=rag_ml
EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
EMBEDDING_DIM=768
KNOWLEDGE_RERANKER_MODEL=itdainb/PhoRanker
RAG_ML_DEVICE=cpu
RAG_ML_WARMUP_ON_START=false
RAG_EMBED_TIMEOUT=8
RAG_RERANK_TIMEOUT=6
KNOWLEDGE_HYBRID_CANDIDATES=12
RAG_ML_MAX_RERANK_TEXTS=12

# Cache / sidecars
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TIMEOUT=0.15
REDIS_PREFIX=shop:
# Browser/device HTTP cache for public catalog and knowledge GET endpoints.
# Chatbot POST responses and account data always use no-store.
CLIENT_CACHE_TTL=60
CLIENT_CACHE_STALE_TTL=30
RERANKER_URL=http://reranker:8000

# Database (for local dev without Docker)
DB_HOST=localhost
DB_NAME=shop_db
DB_USER=root
DB_PASS=

# Admin credentials (auto-created on first start)
ADMIN_EMAIL=admin@shop.com
ADMIN_PASSWORD=your-admin-password-here
