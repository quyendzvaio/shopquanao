# ─────────────────────────────────────────────
# Fashion Shop — Environment Template
# Copy to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────
LLM_PROVIDER=deepseek
LLM_API_KEY=your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# RAG / VectorDB
QDRANT_URL=http://qdrant:6333
RAG_ML_URL=http://rag-ml:8000
KNOWLEDGE_COLLECTION=shop_knowledge_v2
EMBEDDING_PROVIDER=rag_ml
EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
EMBEDDING_DIM=768
KNOWLEDGE_RERANKER_MODEL=itdainb/PhoRanker
RAG_ML_DEVICE=cpu
RAG_ML_WARMUP_ON_START=false
RAG_EMBED_TIMEOUT=8
RAG_RERANK_TIMEOUT=6
KNOWLEDGE_HYBRID_CANDIDATES=12
RAG_ML_MAX_RERANK_TEXTS=12

# Cache / sidecars
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PREFIX=shop:
RERANKER_URL=http://reranker:8000

# Database (for local dev without Docker)
DB_HOST=localhost
DB_NAME=shop_db
DB_USER=root
DB_PASS=

# Admin credentials (auto-created on first start)
ADMIN_EMAIL=admin@shop.com
ADMIN_PASSWORD=your-admin-password-here
