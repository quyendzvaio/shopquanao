# ═══════════════════════════════════════════════════════════
# Fashion Shop — Environment Variables (example)
# ═══════════════════════════════════════════════════════════
# Cách dùng:
#   cp .env.example .env          # cho dev
#   cp .env.example .env.prod     # cho production (sửa giá trị sau)
#
# ⚠️  DEFAULT VALUES CHỈ DÙNG CHO DEV
#     Production bắt buộc đổi: LLM_API_KEY, MARIADB_ROOT_PASSWORD, DB_PASS
# ═══════════════════════════════════════════════════════════

# ── LLM Provider ──────────────────────────────────────────
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-real-api-key-here      # ⚠️ BẮT BUỘC ĐỔI
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# ── Database ──────────────────────────────────────────────
DB_HOST=db
DB_NAME=shop_db
DB_USER=shop_user
DB_PASS=your-db-password-here               # ⚠️ BẮT BUỘC ĐỔI

# ── MariaDB root ──────────────────────────────────────────
MARIADB_ROOT_PASSWORD=your-root-password-here  # ⚠️ BẮT BUỘC ĐỔI

# ── phpMyAdmin (optional) ─────────────────────────────────
PMA_PASSWORD=your-pma-password-here

# ── Reranker ──────────────────────────────────────────────
RERANKER_URL=http://reranker:8000

# ── Admin ──────────────────────────────────────────────
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=123456
