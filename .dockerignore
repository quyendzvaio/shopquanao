# Production build context only. The runtime image receives explicitly listed
# application paths from Dockerfile; test, evaluation, and generated outputs
# must never be sent to BuildKit.

# ── Version control & IDE ──────────────────────────────────
.git
.gitignore
.gitattributes
.codegraph
.agents
.codex
.claude
.vscode
.idea
.specify
.ua
.playwright-cli/

# ── CI/CD & Documentation ─────────────────────────────────
.github
docs/
*.md
DOCKER.md
CLAUDE.md

# ── Test and evaluation suites ─────────────────────────────
tests/
eval/

# ── Reports — dev-only ────────────────────────────────────
reports/
test-evidence/
postman/
.phpunit.cache/

# ── Node / MCP — Docker compiles src itself and copies only dist + prod deps.
mcp-server/node_modules/
mcp-server/dist/
mcp-server/tests/
mcp-server/coverage/
mcp-server/*.tsbuildinfo

# ── PHP development dependencies — runtime has no Composer autoload usage ──
vendor/
composer.phar
composer.lock

# ── Docker meta-files ─────────────────────────────────────
docker-compose.yml
docker-compose*.yml
.dockerignore

# ── Python cache ──────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
.cache/
.huggingface/
hf_cache/
models/
.ragas/
*.arrow
*.parquet
*.safetensors
*.bin
*.pt
*.pth
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Scripts — Python dev scripts excluded from image ──────
scripts/__pycache__/
scripts/eval_rag_chatbot.py

# ── Environment & secrets ─────────────────────────────────
.env
.env.*
.env.local
.env.*.local
.runtime-secrets/
.docker-data/

# ── Logs ─────────────────────────────────────────────────
*.log

# ── OS & editor artifacts ─────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── Backups & archives ────────────────────────────────────
backups/
*.tar
*.tar.gz
*.zip
