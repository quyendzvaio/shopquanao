# ============================================================
# Docker ignore — keep production images lean
# ============================================================

# Version control
.git
.gitignore
.gitattributes
.codegraph

# IDE & editors
.agents
.codex
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# CI/CD
.github

# Documentation (not needed at runtime)
docs/
*.md
DOCKER.md
CLAUDE.md

# Test & reports (heavy, production-irrelevant)
tests/
test-evidence/
reports/
postman/
.phpunit.cache/

# Scripts (dev only)
scripts/
node_modules/
vendor/
composer.phar
composer.lock

# Docker files (not needed inside app image)
docker-compose.yml
docker-compose*.yml
.dockerignore

# Logs
*.log

# OS files
.env.local
.env.*
.env

# Python cache
__pycache__/
*.pyc

# Backups and local dumps
backups/
*.tar
*.tar.gz
*.zip
