# ============================================================
# .dockerignore — keep production images lean
# Aligned with Dockerfile which uses:
#   COPY scripts/   (all scripts)
#   COPY eval/findmine_agent_eval_cases.php
#   COPY tests/fixtures/findmine/fashion-extraction-cases.php
# ============================================================

# ── Version control & IDE ──────────────────────────────────
.git
.gitignore
.gitattributes
.codegraph
.agents
.codex
.claude
.vscode
.idea
.specify
.ua

# ── CI/CD & Documentation ─────────────────────────────────
.github
docs/
*.md
DOCKER.md
CLAUDE.md

# ── Test suite (unit + integration tests stay out of image) ─
# Exception: fixtures used by in-container eval scripts
tests/Unit/
tests/Integration/
tests/jmeter/
tests/README.md
tests/bootstrap.php
tests/eval/
tests/fixtures/findmine/__pycache__/

# ── Eval scripts (Python) & reports — dev-only ────────────
# Exception: the PHP agent eval corpus is COPY'd explicitly
eval/__pycache__/
eval/build_full_agent_eval_report.py
eval/chatbot_eval_cases.jsonl
eval/chatbot_multistep_eval_cases.jsonl
eval/chatbot_positive_eval_cases.jsonl
eval/ragas_compat.py
eval/run_chatbot_eval.py
eval/run_findmine_ragas.py
eval/requirements-eval.txt
reports/
test-evidence/
postman/
.phpunit.cache/

# ── Node / MCP — only compiled dist goes into image ───────
mcp-server/node_modules/
mcp-server/src/
mcp-server/tsconfig.json

# ── PHP deps — installed by composer inside container ─────
vendor/
composer.phar
composer.lock

# ── Docker meta-files ─────────────────────────────────────
docker-compose.yml
docker-compose*.yml
.dockerignore

# ── Python cache ──────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
.cache/
.huggingface/
hf_cache/
models/
.ragas/
.langsmith/
*.arrow
*.parquet
*.safetensors
*.bin
*.pt
*.pth
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Scripts — Python dev scripts excluded from image ──────
scripts/__pycache__/
scripts/eval_rag_chatbot.py

# ── Environment & secrets ─────────────────────────────────
.env
.env.*
.env.local
.env.*.local

# ── Logs ─────────────────────────────────────────────────
*.log

# ── OS & editor artifacts ─────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── Backups & archives ────────────────────────────────────
backups/
*.tar
*.tar.gz
*.zip
